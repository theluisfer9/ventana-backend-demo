{
  "realm": "ventana-magica-dev",
  "enabled": true,
  "displayName": "Ventana de Extracción Dev",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "roles": {
    "realm": [
      {
        "name": "login_access",
        "description": "Permite iniciar sesion en la app"
      },
      {
        "name": "admin",
        "description": "Rol administrativo frontend"
      },
      {
        "name": "user",
        "description": "Rol general frontend"
      }
    ]
  },
  "clients": [
    {
      "clientId": "sicoweb-frontend",
      "name": "Ventana de Extracción Frontend",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "https://pruebas-extracciondatosrsh.mides.gob.gt/*",
        "http://54.244.25.152/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "webOrigins": [
        "https://pruebas-extracciondatosrsh.mides.gob.gt",
        "http://54.244.25.152",
        "http://localhost:5173",
        "http://127.0.0.1:5173"
      ],
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "ventana-backend",
      "name": "Ventana de Extracción Backend (Admin API)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "ventana-backend-dev-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "scopeMappings": [
    {
      "clientScope": "offline_access",
      "roles": [
        "offline_access"
      ]
    }
  ],
  "clientScopeMappings": {
    "realm-management": [
      {
        "client": "ventana-backend",
        "roles": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm",
          "view-realm"
        ]
      }
    ]
  },
  "users": [
    {
      "username": "devadmin",
      "email": "admin@ventanamagica.org",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Admin",
      "lastName": "User",
      "realmRoles": [
        "login_access",
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "Admin123!",
          "temporary": false
        }
      ]
    },
    {
      "username": "service-account-ventana-backend",
      "enabled": true,
      "serviceAccountClientId": "ventana-backend",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users",
          "manage-realm",
          "view-realm"
        ]
      }
    }
  ]
}
